flowchart TB
    citizen(["Citizen (public user)"])
    officer(["MOPS Employee (scholarship officer)"])

    subgraph CR["Keycloak — citizens realm  (audience: the public)"]
        cportal["Citizen Portal / mops-citizen-services<br/>OIDC client · Auth Code + PKCE"]
        ctok["Token A<br/>iss = citizens · userType = CITIZEN"]
    end

    subgraph GR["Keycloak — gov realm  (audience: employees)"]
        mportal["mops-portal (internal)<br/>OIDC client · Auth Code + PKCE"]
        gtok["Token B<br/>iss = gov · role = HR_OFFICER · ministry = MOPS"]
    end

    subgraph BE["Shared Backend API"]
        val["Validate token: match iss to the right realm JWKS<br/>(citizens JWKS OR gov JWKS) · reject unknown issuer"]
        route{"identityDomain by iss"}
        cep["Citizen endpoints<br/>enforce OWNERSHIP (owner_sub == token.sub)"]
        eep["Employee endpoints<br/>enforce ROLE + MINISTRY"]
    end

    db[("PostgreSQL<br/>scholarship_applications<br/>owner_sub · ministry=MOPS · status")]
    files[("File storage<br/>keyed to application id")]

    %% Citizen submit path
    citizen -->|1. login once, SSO| cportal
    cportal --> ctok
    ctok -->|2. POST /scholarship-applications + uploads| val
    val --> route
    route -->|iss = citizens| cep
    cep -->|3. create row: status = SUBMITTED| db
    cep -->|store files| files

    %% Employee process path
    officer -->|4. login| mportal
    mportal --> gtok
    gtok -->|5. GET /scholarship-applications?ministry=MOPS| val
    route -->|iss = gov| eep
    eep -->|6. read queue| db
    eep -->|7. POST /:id/review · /endorse · /approve| db

    %% Citizen track path
    ctok -->|8. GET /scholarship-applications/mine| val
    cep -->|9. read own record + status| db

    %% Explicit no-cross-realm note
    CR -. "NO realm-to-realm auth — the two realms never talk;<br/>they meet only at the shared DB row" .- GR

# Copy to .env (docker compose reads it automatically). POC values only: in a real
# deployment these belong in a secrets manager, never in a file.

# --- Keycloak and its own PostgreSQL ---
KC_DB_PASSWORD=change-me-keycloak-db
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# --- Citizen 360 (ClickHouse) ---
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change-me-clickhouse-admin
# The Resolver's own ClickHouse user (the only writer).
RESOLVER_CH_PASSWORD=change-me-resolver-ch

# --- Service keys ---
# Keycloak SPI, registries and the seed loader send this to the Resolver.
RESOLVER_SERVICE_KEY=poc-resolver-service-key
# Back-office key for the registry GET APIs (seed loader extract, curl demo).
REGISTRY_API_KEY=poc-registry-api-key

# --- Registry PostgreSQL ---
REGISTRY_DB_PASSWORD=change-me-registry-db

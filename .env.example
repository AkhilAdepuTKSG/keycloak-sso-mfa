# Copy to .env and change the values. `docker compose` reads .env automatically.
# For a real deployment these belong in a secrets manager, not a file.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Keycloak bootstrap admin (create named admins after first login) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# --- Provisioning service accounts ---
# MUST match the client secrets in the realm JSON files.
PROVISIONING_CLIENT_SECRET=poc-dev-provisioning-secret
CITIZEN_PROVISIONING_CLIENT_SECRET=poc-dev-citizen-provisioning-secret

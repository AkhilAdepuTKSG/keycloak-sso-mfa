  "authenticationFlows": [
    {
      "alias": "citizen-browser",
      "description": "Cookie (SSO) or the Citizen 360 identifier-first forms, with ACR/LoA step-up",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "citizen-browser-forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "citizen-browser-forms",
      "description": "One conditional sub-flow per assurance level",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "citizen-level-verified",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "citizen-level-high",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "citizen-level-verified",
      "description": "LoA 2 (verified): any ID the portal accepts + password, resolved through Citizen 360",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa-verified",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "citizen-identifier-first",
          "authenticatorConfig": "citizen-identifier-defaults",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "citizen-level-high",
      "description": "LoA 3 (high): EID step-up on top of the existing session",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa-high",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "citizen-eid-step-up",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa-verified",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "loa-high",
      "config": {
        "loa-condition-level": "3",
        "loa-max-age": "3600"
      }
    },
    {
      "alias": "citizen-identifier-defaults",
      "config": {
        "defaultIdTypes": "NIS,NATIONAL_ID,PASSPORT,DL,EID"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [

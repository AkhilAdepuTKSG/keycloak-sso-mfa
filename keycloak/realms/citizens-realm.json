{
  "realm": "citizens",
  "enabled": true,
  "displayName": "Government Citizens",
  "sslRequired": "external",
  "registrationAllowed": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8)",
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "CITIZEN", "description": "Base role for every citizen" },
      { "name": "NIS_MEMBER", "description": "Citizen enrolled in the National Insurance Scheme. Granted by the citizen-services backend on NIS registration (not self-assignable)." }
    ]
  },
  "clients": [
    {
      "clientId": "citizen-portal",
      "name": "Citizen Portal (hub)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "mps-portal",
      "name": "MPS Services",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3001",
      "baseUrl": "http://localhost:3001",
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "nis-portal",
      "name": "NIS Services",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3002",
      "baseUrl": "http://localhost:3002",
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "citizen-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "citizen-api", "id.token.claim": "false", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "gpl-portal",
      "name": "GPL Services",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3003",
      "baseUrl": "http://localhost:3003",
      "redirectUris": ["http://localhost:3003/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "citizen-api",
      "name": "Citizen Services API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "citizen-provisioning-service",
      "name": "Citizen Provisioning Service (service account)",
      "description": "Confidential service account the citizen-services backend uses to grant service-enrolment roles (e.g. NIS_MEMBER). Rotate the secret outside local POC.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "poc-dev-citizen-provisioning-secret",
      "attributes": {}
    }
  ],
  "users": [
    {
      "username": "citizen",
      "email": "citizen@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Citizen",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "Password123!", "temporary": false }
      ],
      "realmRoles": ["CITIZEN"]
    },
    {
      "username": "service-account-citizen-provisioning-service",
      "enabled": true,
      "serviceAccountClientId": "citizen-provisioning-service",
      "clientRoles": {
        "realm-management": ["manage-users", "query-users", "view-users", "view-realm"]
      }
    }
  ]
}

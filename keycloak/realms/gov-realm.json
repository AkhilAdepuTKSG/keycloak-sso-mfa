{
  "realm": "gov",
  "enabled": true,
  "displayName": "Government Employees",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 20,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(10) and specialChars(1) and notUsername(undefined)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,

  "roles": {
    "realm": [
      { "name": "EMPLOYEE", "description": "Base role for every government employee (granted via agency group)." },
      { "name": "AGENCY_ORIGINATOR", "description": "Designated originator — may raise employment requests into MPS. Granted ONLY via the agency's /Originators sub-group, not by plain agency membership." },
      { "name": "HR_OFFICER", "description": "MPS: validates documents / per-line review." },
      { "name": "CPO", "description": "MPS: Chief Personnel Officer — assigns, reassigns and endorses." },
      { "name": "PERMANENT_SECRETARY", "description": "Senior authority; sole final approver/signatory within own ministry." },
      { "name": "MINISTER", "description": "MPS: Honourable Minister — aggregate summary-sheet review." },
      { "name": "CONFIDENTIAL_SECRETARY", "description": "MPS: PS Confidential Secretary." },
      { "name": "IT_ADMIN", "description": "MPS IT Administrator — provisions workforce users via the portal (backend-mediated)." },
      { "name": "MINISTRY_ADMIN", "description": "Group-scoped administrator for one agency." },
      {
        "name": "STAFF",
        "description": "Composite convenience role — any MPS internal staff persona.",
        "composite": true,
        "composites": { "realm": ["HR_OFFICER", "CPO", "PERMANENT_SECRETARY", "MINISTER", "CONFIDENTIAL_SECRETARY", "IT_ADMIN"] }
      }
    ]
  },

  "groups": [
    {
      "name": "Agencies",
      "subGroups": [
        {
          "name": "MPS",
          "attributes": { "agency_id": ["MPS"], "agency_name": ["Ministry of Public Service"] },
          "realmRoles": ["EMPLOYEE"]
        },
        {
          "name": "MOH",
          "attributes": { "agency_id": ["MOH"], "agency_name": ["Ministry of Health"] },
          "realmRoles": ["EMPLOYEE"],
          "subGroups": [
            { "name": "Originators", "realmRoles": ["AGENCY_ORIGINATOR"] }
          ]
        },
        {
          "name": "MOF",
          "attributes": { "agency_id": ["MOF"], "agency_name": ["Ministry of Finance"] },
          "realmRoles": ["EMPLOYEE"],
          "subGroups": [
            { "name": "Originators", "realmRoles": ["AGENCY_ORIGINATOR"] }
          ]
        },
        {
          "name": "MOA",
          "attributes": { "agency_id": ["MOA"], "agency_name": ["Ministry of Agriculture"] },
          "realmRoles": ["EMPLOYEE"],
          "subGroups": [
            { "name": "Originators", "realmRoles": ["AGENCY_ORIGINATOR"] }
          ]
        },
        {
          "name": "MOE",
          "attributes": { "agency_id": ["MOE"], "agency_name": ["Ministry of Education"] },
          "realmRoles": ["EMPLOYEE"],
          "subGroups": [
            { "name": "Originators", "realmRoles": ["AGENCY_ORIGINATOR"] }
          ]
        },
        {
          "name": "REG4",
          "attributes": { "agency_id": ["REG4"], "agency_name": ["Region 4"] },
          "realmRoles": ["EMPLOYEE"],
          "subGroups": [
            { "name": "Originators", "realmRoles": ["AGENCY_ORIGINATOR"] }
          ]
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "mps-portal",
      "name": "MPS Employee Portal",
      "description": "Single MoPS workforce portal. Screens differentiate by the user's agency (group) + roles.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3100",
      "baseUrl": "http://localhost:3100",
      "redirectUris": ["http://localhost:3100/*"],
      "webOrigins": ["http://localhost:3100"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "agency",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "agency",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "backend-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "backend-api", "id.token.claim": "false", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "backend-api",
      "name": "Government Backend API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "provisioning-service",
      "name": "MPS Provisioning Service (service account)",
      "description": "Confidential service-account client the BACKEND uses to provision users via the Keycloak Admin API. Rotate the secret outside local POC.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "poc-dev-provisioning-secret",
      "attributes": {}
    }
  ],

  "users": [
